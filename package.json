{
  "name": "whale-on-desk",
  "version": "2.2.1",
  "description": "A pixel-art whale desktop companion for DeepSeek Harness — it swims while your agents work and taps the glass when an approval is waiting.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./assets/manifest.json": "./assets/manifest.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "tools"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "web-ui",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "react": "*"
  },
  "scripts": {
    "test": "node --test test/pet-machine.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookiesheep/whale-on-desk.git"
  },
  "homepage": "https://cookiesheep.github.io/whale-on-desk",
  "bugs": "https://github.com/cookiesheep/whale-on-desk/issues"
}
